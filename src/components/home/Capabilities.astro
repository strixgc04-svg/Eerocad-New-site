---
/*
 * Replaces the old site's "benefits" tag cloud (Enhanced UX, Boosted
 * Conversions, Fast Loading, SEO Optimized, Scalable, Expandable...), which
 * was keyword soup with no claim behind it.
 *
 * These are capabilities stated plainly, not promises of outcomes.
 */
const capabilities = [
  'Shopify',
  'WordPress',
  'Astro',
  'React',
  'Framer',
  'Meta Ads',
  'Google Ads',
  'GA4',
  'Technical SEO',
  'Local SEO',
  'Conversion tracking',
  'Core Web Vitals',
  'Accessibility',
  'Content strategy',
];

const pill =
  'flex-none rounded-full border border-border bg-white px-5 py-2.5 text-sm whitespace-nowrap text-muted-foreground';
---

<section aria-labelledby="capabilities-heading" class="py-16 sm:py-20">
  <div class="container-page">
    <h2 id="capabilities-heading" class="sr-only">What we work with</h2>
    <p class="eyebrow mb-8" data-reveal>What we work with</p>
  </div>

  <div class="marquee" style="--marquee-duration: 54s; --marquee-gap: 0.75rem;">
    <ul class="marquee__track list-none">
      {capabilities.map((c) => <li class={pill}>{c}</li>)}
    </ul>
    <ul class="marquee__track list-none" aria-hidden="true" inert>
      {capabilities.map((c) => <li class={pill}>{c}</li>)}
    </ul>
  </div>
</section>
