---
import { getCollection } from 'astro:content';

/*
 * Cards link to real case-study URLs ONLY when that case study is actually
 * published. Anything not yet written renders as a non-interactive card.
 *
 * This used to hard-code four hrefs, which produced four 404s the moment the
 * entries were drafts — the exact failure this rebuild exists to fix.
 * Deriving from the collection makes a dead link structurally impossible.
 */
const published = new Set(
  (await getCollection('work', ({ data }) => !data.draft)).map((e) => e.id),
);

/*
 * `blurb` states scope and nothing else. Each one is drawn from the services
 * and opening paragraph of that client's own case study on the current site
 * (content/eerocad-site-content.md) — what was done, never what it achieved.
 *
 * No outcome belongs on a card. The numbers on the current site are
 * unsourced, and the work collection's schema requires a `period` and a
 * `source` for every figure precisely so none can reach a page without one.
 *
 * `tint` is the inside of the folder, not a background wash — the sheet and
 * the flap are both paper white, so it has to be deep enough to separate
 * two white planes from each other. These are a couple of steps down from
 * the pale section tints used elsewhere for exactly that reason.
 */
const projects = [
  {
    slug: 'dhillon-of-london',
    client: 'Dhillon of London',
    sector: 'Luxury transport',
    blurb: 'Brand identity and social content for a luxury coach fleet.',
    shot: '/brand/work/dhillon-of-london.jpg',
    year: '2024',
    tint: 'from-[#e8d8d2] to-[#dbc8c0]',
  },
  {
    slug: 'adachi',
    client: 'Adachi',
    sector: 'Hospitality',
    // Deliberately no city: the current site puts this restaurant in London
    // in the case study and in Birmingham, Michigan in the testimonial.
    blurb: 'Identity and local search for a Japanese fine-dining restaurant.',
    shot: '/brand/work/adachi.jpg',
    year: '2024',
    tint: 'from-[#e3dfd3] to-[#d3cdbd]',
  },
  {
    slug: 'ayunik',
    client: 'Ayunik Clothing',
    sector: 'Ecommerce',
    blurb: 'A mobile-first Shopify store for a modest-wear clothing label.',
    shot: '/brand/work/ayunik.jpg',
    year: '2025',
    tint: 'from-[#eddad5] to-[#ddc5c0]',
  },
  {
    slug: 'escalate',
    client: 'Escalate Digital',
    sector: 'B2B marketing',
    blurb: 'Identity, messaging and a new site for a marketing agency.',
    // No shot: escalatedigital.in serves an expired certificate (SAN covers
    // the apex only, and it lapsed on 27 Oct 2026), so the site cannot be
    // reached without turning certificate checking off. Keeps the
    // placeholder until the certificate is renewed. See docs/content-todo.md.
    shot: null,
    year: '2024',
    tint: 'from-[#dee1dc] to-[#cdd2cc]',
  },
].map((p) => ({ ...p, live: published.has(p.slug) }));

/*
 * The card is a folder: the tint is the inside of the pocket, the sheet is
 * the project filed in it, the flap carries the type. `.folder` in
 * global.css owns the geometry and the open-on-hover gesture.
 *
 * aspect-ratio rather than content height, so all four cards agree and the
 * flap's percentage lip means the same thing on every one of them.
 */
const cardClass = 'folder card-panel block aspect-[7/6] lg:aspect-[5/4]';
---

<section id="work" aria-labelledby="work-heading" class="container-page section-y">
  <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
    <div class="max-w-2xl">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-heading" class="display-lg mt-5 text-balance">
        Where they started. What <span class="accent-italic text-primary">changed</span>.
      </h2>
    </div>
    <a
      href="/work/"
      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-white px-5 text-sm font-medium transition-colors hover:bg-paper-warm"
    >
      All case studies <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <ul class="section-gap grid gap-5 sm:grid-cols-2" data-stagger>
    {
      projects.map((p) => {
        const inner = (
          <>
            <span class={`absolute inset-0 bg-gradient-to-br ${p.tint}`} aria-hidden="true" />

            {/*
              The filed item: a screenshot of the site itself where one could
              be taken, the placeholder where it could not. The box is
              positioned either way, so CLS stays 0.

              The screenshot carries real alt text and the sheet is not
              hidden from assistive tech, because it is the work. The
              placeholder is, because "Project imagery" is not.

              The image is taller than the sheet, anchored above it, so the
              parallax has somewhere to travel without exposing an edge.
              Only the vertical needs headroom: the parallax is yPercent.

              No background behind a screenshot — the pocket tint shows
              through until the lazy image arrives, which is a better
              holding colour than a white rectangle.
            */}
            <div
              class:list={['folder__sheet', !p.shot && 'bg-paper']}
              aria-hidden={p.shot ? undefined : 'true'}
            >
              {p.shot ? (
                <img
                  src={p.shot}
                  alt={`The ${p.client} website`}
                  width="1000"
                  height="625"
                  data-parallax
                  loading="lazy"
                  decoding="async"
                  class="absolute -top-[7%] left-0 h-[114%] w-full object-cover object-top"
                />
              ) : (
                <>
                  <div
                    data-parallax
                    class="absolute inset-[-12%] bg-[radial-gradient(55%_55%_at_50%_40%,rgb(211_47_47_/_0.08),transparent_70%)]"
                  />
                  {/* Centred on the part of the sheet the flap does not
                      cover, not on the sheet, so the label sits in the
                      middle of what you can actually see. */}
                  <div class="absolute inset-x-0 top-0 grid h-[64%] place-items-center">
                    <span class="eyebrow">Project imagery</span>
                  </div>
                </>
              )}
            </div>

            <div class="folder__face">
              <span class="folder__tab font-mono text-xs text-ink-subtle">/{p.year}</span>

              <div class="folder__body">
                <div>
                  <p class="eyebrow">{p.sector}</p>
                  <p class="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">{p.client}</p>
                </div>

                <div class="flex items-end justify-between gap-4">
                  <p class="max-w-md text-sm text-muted-foreground">{p.blurb}</p>
                  {p.live && (
                    <span
                      class="inline-flex size-9 flex-none items-center justify-center rounded-full bg-paper-warm transition-colors group-hover:bg-primary group-hover:text-white"
                      aria-hidden="true"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="7" y1="17" x2="17" y2="7" />
                        <polyline points="7 7 17 7 17 17" />
                      </svg>
                    </span>
                  )}
                </div>
              </div>
            </div>
          </>
        );

        return (
          <li data-stagger-item>
            {p.live ? (
              <a
                href={`/work/${p.slug}/`}
                class={`group transition-colors duration-300 hover:border-primary/40 ${cardClass}`}
              >
                {inner}
              </a>
            ) : (
              <div class={cardClass}>
                {inner}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>

</section>
