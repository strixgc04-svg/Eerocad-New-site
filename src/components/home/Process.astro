---
const stages = [
  {
    n: '01',
    title: 'Discovery',
    body: 'A paid-for scoping session, not a sales call. We work out what you actually need, what it should cost, and whether we are the right people to build it.',
    points: ['Written scope and roadmap', 'Fixed quote inside 48 hours'],
  },
  {
    n: '02',
    title: 'Build',
    body: 'You see the work as it happens, in a shared environment, with a named lead. No month of silence followed by a reveal.',
    points: ['Staging link from week one', 'One point of contact'],
  },
  {
    n: '03',
    title: 'Launch & beyond',
    body: 'You get everything: the code, the accounts, the analytics, the documentation. Owned by you, whether or not you keep working with us.',
    points: ['Full handover of accounts', 'Ongoing support if you want it'],
  },
];
---

<section
  id="process"
  aria-labelledby="process-heading"
  class="border-y border-border bg-paper-warm py-24 sm:py-32"
>
  <div class="container-page">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">How we work</p>
      <h2 id="process-heading" class="display-lg mt-5 text-balance">
        From idea to impact, without the <span class="accent-italic text-primary"
          >mystery</span
        >.
      </h2>
      <p class="mt-5 text-lg text-muted-foreground">
        Three stages. You always know where the project is and what happens next.
      </p>
    </div>

    <div class="rail mt-16 pl-10 sm:pl-16" data-rail>
      <div class="rail__line left-0" aria-hidden="true"></div>
      <div class="rail__progress left-0" data-rail-progress aria-hidden="true"></div>

      <ol class="space-y-10 sm:space-y-20">
        {
          stages.map((stage) => (
            <li class="relative" data-reveal>
              <span
                class="absolute top-2 -left-10 flex size-5 items-center justify-center sm:-left-16"
                aria-hidden="true"
              >
                <span class="size-2.5 rounded-full bg-primary ring-4 ring-paper-warm" />
              </span>

              <div
                class="card-soft sm:p-9"
              >
                <p class="font-mono text-xs text-primary tabular-nums">{stage.n}</p>
                <h3 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">
                  {stage.title}
                </h3>
                <p class="mt-4 max-w-xl text-muted-foreground">{stage.body}</p>

                <ul class="mt-6 flex flex-wrap gap-2">
                  {stage.points.map((p) => (
                    <li class="rounded-full border border-border bg-paper-warm px-3.5 py-1.5 text-xs text-muted-foreground">
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
