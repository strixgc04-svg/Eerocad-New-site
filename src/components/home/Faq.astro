---

/*
 * Native <details>. Zero JavaScript, keyboard accessible by default, and -
 * critically - every answer is in the HTML.
 *
 * On the current site the FAQ answers are injected into the DOM on click and
 * exist nowhere beforehand, so no crawler and no AI agent can read them.
 *
 * No FAQPage schema: Google retired FAQ rich results for all sites on
 * 2026-05-07, so it buys nothing and is one more thing to keep in sync.
 */
const faqs = [
  {
    q: 'What does Eerocad actually do?',
    a: 'Website development (Shopify, WordPress, Astro, React and Framer), SEO covering technical, on-page and off-page work, performance marketing across Meta and Google Ads including funnels and lead handling, and social media management.',
  },
  {
    q: 'How much does a website cost?',
    a: 'It depends on scope, which is a real answer rather than a dodge — a brochure site and a Shopify build with integrations are different projects. What we will commit to is a written quote within 48 hours of a scoping call, against a fixed scope, so the number does not move afterwards.',
  },
  {
    q: 'Where are you based?',
    a: 'Eerocad is remote-first and works with clients across the United Kingdom, with a delivery team in New Delhi. Your day-to-day contact is UK-hours.',
  },
  {
    q: 'How long does a project take?',
    a: 'Most marketing sites run a few weeks from agreed scope to launch, driven mostly by how fast content and feedback come back. SEO is different: technical fixes land in weeks, but content and authority work takes months to compound. Anyone promising rankings in a month is describing something that will not last.',
  },
  {
    q: 'Who owns the website and the ad accounts?',
    a: 'You do. Code, domains, analytics and advertising accounts are handed over at launch and remain yours whether or not you keep working with us.',
  },
  {
    q: 'How do I get started?',
    a: 'Book a 30-minute call. We will ask what you are trying to build, tell you roughly what it costs, and say so if we are not the right fit.',
  },
];
---

<section id="faq" aria-labelledby="faq-heading" class="container-page py-24 sm:py-32">
  <div class="grid gap-12 lg:grid-cols-[24rem_1fr]">
    <div data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-heading" class="display-lg mt-5 text-balance">
        Questions people <span class="accent-italic text-primary">actually</span> ask.
      </h2>
      <p class="mt-5 text-muted-foreground">
        If yours is not here,
        <a href="/contact/" class="text-primary-ink underline underline-offset-4"
          >just ask us</a
        >.
      </p>
    </div>

    <div>
      <div class="divide-y divide-border border-y border-border">
        {
          faqs.map((item) => (
            <details class="faq-item group">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-medium transition-colors hover:text-primary">
                <span>{item.q}</span>
                <span
                  class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-border text-xl leading-none transition-all duration-300 group-open:rotate-45 group-open:border-primary group-open:bg-primary group-open:text-white"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="max-w-2xl pb-6 text-muted-foreground">{item.a}</p>
            </details>
          ))
        }
      </div>

    </div>
  </div>
</section>
