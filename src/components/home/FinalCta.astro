---
import RotatingBadge from '@/components/RotatingBadge.astro';

/*
 * One conversion path, one Calendly link, stated plainly.
 *
 * The current site offers six differently-worded CTA labels pointing at two
 * different Calendly events, one of which returns an error.
 *
 * Dark panel: anchors the bottom of a white page. Buttons are white-on-ink
 * rather than red — the fill red as text or as a small element on near-black
 * fails contrast, and white reads cleaner here anyway.
 */
---

<section aria-labelledby="cta-heading" class="container-page pb-8">
  <div
    class="panel-dark dotgrid relative isolate overflow-hidden rounded-[2.5rem] px-6 py-24 sm:px-12 sm:py-32"
  >
    <div class="wash opacity-60" aria-hidden="true">
      <div class="wash__blob wash__blob--1"></div>
    </div>

    <div class="relative mx-auto max-w-4xl">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_auto]">
        <div class="text-center lg:text-left">
          <p class="eyebrow">Next step</p>

          <h2 id="cta-heading" class="display-lg mt-5 text-balance" data-reveal>
            Tell us what you're <span class="accent-italic text-primary"
              >trying to build</span
            >.
          </h2>

          <p
            class="mx-auto mt-6 max-w-lg text-lg text-muted-foreground lg:mx-0"
            data-reveal
          >
            Thirty minutes, no deck, no pressure. You'll leave knowing roughly
            what it costs and how long it takes &mdash; even if you build it
            elsewhere.
          </p>

          <div
            class="mt-10 flex flex-wrap justify-center gap-3 lg:justify-start"
            data-reveal
          >
            <a
              href="/contact/"
              data-magnetic
              class="group inline-flex min-h-13 items-center gap-2 rounded-full bg-white px-8 font-medium text-ink transition-colors hover:bg-primary hover:text-white"
            >
              Book a 30-minute call
              <span
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true">&rarr;</span
              >
            </a>
            <a
              href="mailto:info@eerocad.com"
              class="inline-flex min-h-13 items-center rounded-full border border-white/25 px-8 font-medium transition-colors hover:bg-white/10"
            >
              Email instead
            </a>
          </div>

          {/* Removes the "will they even reply?" objection at the point of ask. */}
          <p class="mt-8 text-sm text-muted-foreground" data-reveal>
            Prefer to write? <a
              href="mailto:info@eerocad.com"
              class="text-primary-ink underline underline-offset-4">info@eerocad.com</a
            > &middot; <a
              href="tel:+447405327656"
              class="text-primary-ink underline underline-offset-4">+44 7405 327656</a
            >
          </p>
        </div>

        <div class="hidden justify-center lg:flex" data-reveal>
          <RotatingBadge tone="dark" text="EEROCAD · UK WEB & GROWTH STUDIO · " />
        </div>
      </div>
    </div>
  </div>
</section>
