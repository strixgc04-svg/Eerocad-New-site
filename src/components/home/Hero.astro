---
import LogoMarquee from './LogoMarquee.astro';
import RotatingBadge from '@/components/RotatingBadge.astro';

/*
 * The LCP element is the <h1>.
 *
 * It uses a line-mask reveal via gsap.from(), so the heading paints in its
 * final state first and GSAP applies the start state afterwards - the LCP
 * candidate lands on that first paint rather than waiting out the animation.
 *
 * Not allowed here: a video LCP element, anything waiting on scroll, anything
 * waiting on the network. The old hero was an unposterable video at 7.8s.
 */
---

<section
  aria-labelledby="hero-heading"
  class="dotgrid relative isolate overflow-hidden pt-28 sm:pt-36 lg:pt-44"
>
  <div class="wash" aria-hidden="true">
    <div class="wash__blob wash__blob--1"></div>
    <div class="wash__blob wash__blob--2"></div>
  </div>

  <div class="container-page relative">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div class="max-w-4xl">
        <p data-hero-item class="eyebrow flex items-center gap-2">
          <span class="relative flex size-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex size-1.5 rounded-full bg-primary"></span>
          </span>
          UK web, marketing &amp; growth
        </p>

        <h1 id="hero-heading" data-hero-heading class="display-xl mt-6 text-balance">
          Websites that sell.<br />Campaigns that <span class="accent-italic text-primary"
            >scale</span
          >.
        </h1>

        <p data-hero-item class="mt-8 max-w-xl text-lg text-muted-foreground sm:text-xl">
          A remote-first digital studio for businesses across the UK. We build
          the site, then run the SEO and paid campaigns that fill it.
        </p>

        <div data-hero-item class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="/contact/"
            data-magnetic
            class="group inline-flex min-h-13 items-center gap-2 rounded-full bg-ink px-7 font-medium text-white transition-colors hover:bg-primary"
          >
            Book a 30-minute call
            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true">&rarr;</span
            >
          </a>
          <a
            href="/work/"
            class="inline-flex min-h-13 items-center rounded-full border border-border bg-white px-7 font-medium transition-colors hover:bg-paper-warm"
          >
            See the work
          </a>
        </div>
      </div>

      <RotatingBadge class="hidden shrink-0 lg:grid" />
    </div>
  </div>

  <div data-hero-item class="relative mt-16 pb-16">
    <LogoMarquee />
  </div>
</section>
