---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
];
---

{/* Floating pill nav, as on the Cohesion and Folioxa references. */}
<header class="pointer-events-none fixed inset-x-0 top-0 z-50 pt-3 sm:pt-5">
  <div class="container-page">
    <div
      class="pointer-events-auto flex items-center justify-between gap-3 rounded-full border border-border bg-white/80 py-2 pr-2 pl-4 backdrop-blur-xl sm:pl-6"
      style="box-shadow: var(--shadow-float);"
    >
      <a href="/" class="flex min-h-11 items-center" aria-label="EeroCad home">
        {/* aria-label already names the link, so the mark is decorative here.
            alt="" stops it being announced a second time. */}
        <img
          src="/brand/eerocad-wordmark.webp"
          alt=""
          width="384"
          height="101"
          class="h-7 w-auto"
          fetchpriority="high"
        />
      </a>

      <nav aria-label="Main" class="hidden items-center gap-0.5 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-4 py-2 text-sm transition-colors',
                isActive(item.href)
                  ? 'bg-paper-warm font-medium text-ink'
                  : 'text-muted-foreground hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/contact/"
          class="hidden min-h-11 items-center rounded-full bg-ink px-5 text-sm font-medium text-white transition-colors hover:bg-primary sm:inline-flex"
        >
          Book a call
        </a>

        {/* Native disclosure: no JS, no hydration, keyboard accessible. */}
        <details class="md:hidden">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-border"
            aria-label="Open menu"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="3" y1="7" x2="21" y2="7"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="17" x2="21" y2="17"></line>
            </svg>
          </summary>

          <div
            class="absolute inset-x-4 top-20 rounded-3xl border border-border bg-white p-4"
            style="box-shadow: var(--shadow-float);"
          >
            <nav aria-label="Mobile" class="flex flex-col">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-12 items-center rounded-full px-4 text-base',
                      isActive(item.href) ? 'bg-paper-warm font-medium' : 'text-muted-foreground',
                    ]}
                  >
                    {item.label}
                  </a>
                ))
              }
              <a
                href="/contact/"
                class="mt-2 flex min-h-12 items-center justify-center rounded-full bg-ink px-5 font-medium text-white"
              >
                Book a call
              </a>
              <a
                href="mailto:info@eerocad.com"
                class="mt-2 flex min-h-11 items-center px-4 text-sm text-muted-foreground"
              >
                info@eerocad.com
              </a>
              <a
                href="tel:+447405327656"
                class="flex min-h-11 items-center px-4 text-sm text-muted-foreground"
              >
                +44 7405 327656
              </a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
