---
interface Props {
  heading?: string;
  accent?: string;
  body?: string;
}

const {
  heading = "Tell us what you're",
  accent = 'trying to build',
  body = 'Thirty minutes, no deck, no pressure. You will leave knowing roughly what it costs and how long it takes — even if you build it elsewhere.',
} = Astro.props;
---

<section aria-labelledby="ctaband-heading" class="mt-24">
  <div
    class="panel-dark dotgrid relative isolate overflow-hidden rounded-[2.5rem] px-6 py-10 text-center sm:px-12 sm:py-20"
  >
    <div class="wash opacity-60" aria-hidden="true">
      <div class="wash__blob wash__blob--1"></div>
    </div>

    <div class="relative">
      <h2 id="ctaband-heading" class="display-lg mx-auto max-w-2xl text-balance" data-reveal>
        {heading} <span class="accent-italic text-primary">{accent}</span>.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-muted-foreground" data-reveal>{body}</p>

      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal>
        <a
          href="/contact/"
          data-magnetic
          class="group inline-flex min-h-13 items-center gap-2 rounded-full bg-white px-8 font-medium text-ink transition-colors hover:bg-primary hover:text-white"
        >
          Book a 30-minute call
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true">&rarr;</span
          >
        </a>
        <a
          href="mailto:info@eerocad.com"
          class="inline-flex min-h-13 items-center rounded-full border border-white/25 px-8 font-medium transition-colors hover:bg-white/10"
        >
          Email instead
        </a>
      </div>
    </div>
  </div>
</section>
