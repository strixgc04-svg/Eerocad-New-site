---
import { SERVICES } from '@/lib/schema';
import RotatingBadge from '@/components/RotatingBadge.astro';

const year = new Date().getFullYear();

const company = [
  { href: '/work/', label: 'Work' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];

const linkClass =
  'flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover:text-white';
---

{/* Floating dark panel, anchoring the bottom of a white page. */}
<footer class="container-page pt-16 pb-5">
  <div
    class="panel-dark dotgrid relative isolate overflow-hidden rounded-[2.5rem] px-6 py-10 sm:px-10 sm:py-16"
  >
    <div class="wash opacity-50" aria-hidden="true">
      <div class="wash__blob wash__blob--2"></div>
    </div>

    <div class="relative grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr_1.1fr]">
      <div>
        {/* The dark-panel variant: white type, red bar kept. A CSS invert()
            would have taken the bar to cyan. Nothing else names the studio
            in this block, so this one carries real alt text. */}
        <img
          src="/brand/eerocad-wordmark-light.png"
          alt="EeroCad"
          width="480"
          height="126"
          class="h-7 w-auto"
          loading="lazy"
          decoding="async"
        />
        <p class="mt-4 max-w-xs text-sm text-muted-foreground">
          A remote-first digital studio serving businesses across the United
          Kingdom.
        </p>

        <div class="mt-9 hidden sm:block">
          <RotatingBadge tone="dark" text="EEROCAD · UK WEB & GROWTH STUDIO · " />
        </div>
      </div>

      <nav aria-label="Services">
        <h2 class="eyebrow">Services</h2>
        <ul class="mt-4 space-y-0.5">
          {
            SERVICES.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`} class={linkClass}>
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2 class="eyebrow">Company</h2>
        <ul class="mt-4 space-y-0.5">
          {
            company.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Contact details on every page. The old site had none here, and its
          only copy sat on a page that returned 404. */}
      <div>
        <h2 class="eyebrow">Contact</h2>
        <ul class="mt-4 space-y-0.5">
          <li>
            <a href="mailto:info@eerocad.com" class={linkClass}>info@eerocad.com</a>
          </li>
          <li>
            {/* href must match the number shown. The old site displayed UK and
                India numbers but dialled tel:+1 988636474 on both. */}
            <a href="tel:+447405327656" class={linkClass}>+44 7405 327656</a>
          </li>
          <li>
            <a href="https://www.instagram.com/eerocad" rel="me noopener" class={linkClass}>
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="relative mt-12 flex flex-col gap-3 border-t border-white/12 pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      {/* See docs/content-todo.md: the registered company name, number, place
          of registration and registered office belong here. There is currently
          no "EeroCad" at Companies House, and UK trading disclosure rules
          generally require these details on a trading website. */}
      <p>&copy; {year} EeroCad. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/privacy-policy/" class="inline-flex min-h-11 items-center hover:text-white">
          Privacy Policy
        </a>
        <a href="/terms/" class="inline-flex min-h-11 items-center hover:text-white">
          Terms &amp; Conditions
        </a>
      </div>
    </div>
  </div>
</footer>
