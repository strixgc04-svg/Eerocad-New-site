---
import type { Crumb } from '@/lib/schema';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{/* Must mirror the BreadcrumbList JSON-LD exactly. */}
<nav aria-label="Breadcrumb" class="container-page">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span class="text-ink-subtle" aria-hidden="true">
              /
            </span>
          )}
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class="inline-flex min-h-9 items-center text-ink">
              {c.name}
            </span>
          ) : (
            <a
              href={c.path}
              class="inline-flex min-h-9 items-center transition-colors hover:text-ink"
            >
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
