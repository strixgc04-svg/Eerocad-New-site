---
interface Props {
  text?: string;
  class?: string;
}

const {
  text = 'BOOK A CALL · NO DECK · NO PRESSURE · ',
  class: className,
} = Astro.props;

const chars = [...text];
const step = 360 / chars.length;
---

{/* Rotating circular badge. Decorative, so the letters are aria-hidden and a
    real label sits on the link. */}
<a
  href="/contact/"
  class:list={[
    'group relative grid size-28 place-items-center [--badge-r:3.05rem] sm:size-32 sm:[--badge-r:3.55rem]',
    className,
  ]}
  aria-label="Book a call"
>
  <span
    class="absolute inset-0 motion-safe:animate-[spin_18s_linear_infinite] group-hover:[animation-play-state:paused]"
    aria-hidden="true"
  >
    {
      chars.map((ch, i) => (
        <span
          class="absolute top-1/2 left-1/2 text-[0.6rem] font-medium text-muted-foreground"
          /*
           * translate(-50%, -50%) FIRST, so each glyph is centred on the
           * circle's origin before it is rotated outward.
           *
           * Without it the glyph's top-left corner sits on the origin, so
           * every character is displaced by half its own width — and because
           * W, & and I differ in width, each is displaced by a different
           * amount. That is what made the ring look unevenly spaced.
           *
           * No letter-spacing here either: on a single character it adds a
           * trailing space, shifting the glyph off its own centre.
           */
          style={`transform: translate(-50%, -50%) rotate(${(i * step).toFixed(3)}deg) translateY(calc(var(--badge-r) * -1));`}
        >
          {ch === ' ' ? ' ' : ch}
        </span>
      ))
    }
  </span>

  <span
    class="grid size-16 place-items-center rounded-full bg-ink text-white transition-colors group-hover:bg-primary sm:size-18"
    aria-hidden="true"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    >
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </span>
</a>
