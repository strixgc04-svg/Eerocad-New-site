---
interface Props {
  text?: string;
  class?: string;
}

const {
  text = 'BOOK A CALL · NO DECK · NO PRESSURE · ',
  class: className,
} = Astro.props;

const chars = [...text];
const step = 360 / chars.length;
---

{/* Rotating circular badge, as on the Petalwalk reference. Decorative, so the
    letters are aria-hidden and a real label sits underneath. */}
<a
  href="/contact/"
  class:list={['group relative grid size-28 place-items-center sm:size-32', className]}
  aria-label="Book a call"
>
  <span
    class="absolute inset-0 motion-safe:animate-[spin_18s_linear_infinite] group-hover:[animation-play-state:paused]"
    aria-hidden="true"
  >
    {
      chars.map((ch, i) => (
        <span
          class="absolute top-1/2 left-1/2 text-[0.6rem] font-medium tracking-[0.1em] text-muted-foreground"
          style={`transform: rotate(${i * step}deg) translateY(-3.4rem);`}
        >
          {ch}
        </span>
      ))
    }
  </span>

  <span
    class="grid size-16 place-items-center rounded-full bg-ink text-white transition-colors group-hover:bg-primary sm:size-18"
    aria-hidden="true"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    >
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </span>
</a>
