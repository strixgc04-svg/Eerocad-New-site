---
import '@/styles/global.css';
import SeoHead from '@/components/SeoHead.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { organization, website } from '@/lib/schema';
import { GTM_ID } from '@/lib/site.js';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Page-specific JSON-LD nodes. Organization and WebSite are always included. */
  graph?: Record<string, unknown>[];
  /** The intro curtain is for the home page only. */
  intro?: boolean;
}

const { title, description, image, noindex, type, graph = [], intro = false } =
  Astro.props;

/*
 * Built as a string and injected with set:html, not written inline in the
 * template.
 *
 * Inside an Astro expression the children of <script> are still parsed as
 * JSX, so every `{` in the JS opens an expression. Written literally it
 * compiled to `{\`...\`}` — a block statement holding a template literal,
 * which is valid JavaScript that evaluates a string and throws it away. The
 * tag shipped, the snippet never ran, and nothing about the page looked
 * wrong. Only reading the built HTML showed it.
 */
const gtm =
  GTM_ID && import.meta.env.PROD
    ? `window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('consent','default',{
  ad_storage:'denied',
  ad_user_data:'denied',
  ad_personalization:'denied',
  analytics_storage:'denied',
  security_storage:'granted',
  wait_for_update:500
});
(function(w,d,s,l,i){
  var done=false;
  function load(){
    if(done) return; done=true;
    w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
    f.parentNode.insertBefore(j,f);
  }
  function schedule(){
    if(w.requestIdleCallback) w.requestIdleCallback(load,{timeout:2500});
    else w.setTimeout(load,1200);
  }
  ['pointerdown','keydown','touchstart','scroll'].forEach(function(e){
    w.addEventListener(e,load,{once:true,passive:true});
  });
  if(d.readyState==='complete') schedule();
  else w.addEventListener('load',schedule,{once:true});
})(window,document,'script','dataLayer','${GTM_ID}');`
    : '';
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Self-hosted and same-origin, so no third-party round trip before text.

      Preloaded deliberately: tested without it and CLS rose from 0.001 to
      0.018, because the metric-matched fallback is close but not exact and
      the swap still nudges layout. CLS is a real user-facing metric, so it
      wins over a simulated LCP figure.
    */}
    <link
      rel="preload"
      href="/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Google Tag Manager.

      Production only: a dev server reloads constantly and would report every
      one of those into the live container.

      The consent defaults run BEFORE the loader, and that ordering is the
      whole point — Consent Mode has to be set before the tag it governs, or
      the tag has already acted. Everything non-essential starts denied, so
      GTM loads but sets no analytics or advertising cookie until something
      calls gtag('consent','update',...). There is no cookie banner on this
      site yet, and under PECR consent has to come before the cookie rather
      than after it. `gtag` is left on window for that banner to call.

      The snippet supplied was a gtag/GTM hybrid: the gtm.js loader with
      gtag.js bootstrap lines, no container config and no <noscript>. This
      is GTM's own snippet instead.

      The loader is deferred off the critical path. Measured on the live
      site, gtm.js is 178 KiB — 44% of the page and the largest request on
      it by a factor of three — and it was holding LCP at 3.3s. It now
      loads on whichever comes first: the first real interaction
      (pointerdown, keydown, touchstart, scroll), or an idle callback after
      the load event, capped at 2.5s so a page nobody touches still reports.

      The consent defaults above are NOT deferred, and must never be: they
      have to be in the dataLayer before gtm.js arrives, and deferring the
      loader only widens that margin.
    */}
    {gtm && <script is:inline set:html={gtm} />}

    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      type={type}
    />

    <JsonLd graph={[organization, website, ...graph]} />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script is:inline define:vars={{ introEnabled: intro }}>
      (function () {
        if (!introEnabled) return;
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('eerocad-intro')) return;
          sessionStorage.setItem('eerocad-intro', '1');
          document.documentElement.classList.add('intro-active');
        } catch (e) {
          /* private mode or blocked storage: just skip the intro */
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh antialiased">
    {
      GTM_ID && import.meta.env.PROD && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }

    {
      intro && (
        <div class="intro" aria-hidden="true" data-intro>
          <p class="intro__mark">
            <span class="intro__bar" />
            EeroCad
          </p>
          <span class="intro__count" data-intro-count>
            0
          </span>
        </div>
      )
    }

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[300] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  /* The curtain only renders when the inline script opted in. */
  html:not(.intro-active) [data-intro] {
    display: none;
  }
</style>
