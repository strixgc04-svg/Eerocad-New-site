---
import PageLayout from '@/layouts/PageLayout.astro';

/*
 * Written to describe what this site actually does today, rather than a
 * downloaded template. The previous site's policy was an unedited template
 * that named support@landin.com as its contact.
 *
 * It MUST be revised when any of these land: an enquiry form, analytics, an
 * advertising pixel, or a cookie banner. See docs/content-todo.md.
 */
const path = '/privacy-policy/';
const title = 'Privacy Policy | EeroCad';
const description =
  'What data this website collects, what EeroCad does with it, and the rights you have over it under UK GDPR.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Privacy Policy', path },
];

const updated = '2 November 2026';
---

<PageLayout
  title={title}
  description={description}
  heading="Privacy"
  headingAccent="Policy"
  lead={`Last updated ${updated}.`}
  path={path}
  crumbs={crumbs}
>
  <div class="prose-page max-w-2xl">
    <h2>The short version</h2>
    <p>
      This website does not set analytics or advertising cookies, and it has no
      forms. If you email us or book a call, we hold what you send us so we can
      reply. We do not sell or rent anyone's data.
    </p>

    <h2>What this site collects</h2>
    <p>
      Browsing these pages involves no tracking cookies and no analytics. Our
      hosting provider keeps standard server logs, which include IP addresses,
      for security and reliability purposes.
    </p>
    <p>
      The site stores one item in your browser's session storage to remember
      that you have already seen the introductory animation. It contains no
      personal data, it is not shared with anyone, and it is cleared when you
      close the tab.
    </p>

    <h2>If you contact us</h2>
    <p>
      If you email <a href="mailto:info@eerocad.com">info@eerocad.com</a> or call
      us, we keep your message and contact details so we can respond and, if we
      end up working together, to administer that work.
    </p>
    <p>
      Our booking link is hosted by Calendly. If you book a call, the details
      you enter there are processed by Calendly under their own privacy policy
      as well as being shared with us.
    </p>

    <h2>How long we keep it</h2>
    <p>
      Enquiries that do not lead to work are kept for up to two years, in case
      you come back. Records relating to work we carry out are kept for as long
      as we are required to retain business and tax records.
    </p>

    <h2>Your rights</h2>
    <p>
      Under UK GDPR you can ask us for a copy of the personal data we hold about
      you, ask us to correct it, ask us to delete it, or object to how we are
      using it. Email <a href="mailto:info@eerocad.com">info@eerocad.com</a> and
      we will respond within one month.
    </p>
    <p>
      If you are not satisfied with our response you can complain to the
      Information Commissioner's Office at
      <a href="https://ico.org.uk/" rel="noopener">ico.org.uk</a>.
    </p>

    <h2>Changes</h2>
    <p>
      If we add an enquiry form, analytics or advertising tracking to this site,
      this policy will be updated before those go live, and a cookie notice will
      be added where one is required.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy: <a href="mailto:info@eerocad.com"
        >info@eerocad.com</a
      >.
    </p>
  </div>
</PageLayout>
