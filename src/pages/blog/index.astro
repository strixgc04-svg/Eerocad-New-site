---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { orgRef, abs, SITE } from '@/lib/schema';

const path = '/blog/';
const title = 'Blog | Web, SEO & Paid Ads Notes | EeroCad';
const description =
  'Practical notes on building and marketing websites in the UK: what things cost, what breaks, and what we would do differently.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const extraGraph = [
  {
    '@type': 'Blog',
    '@id': `${SITE}/blog/#blog`,
    url: abs(path),
    name: 'EeroCad Blog',
    description,
    inLanguage: 'en-GB',
    publisher: orgRef(),
  },
];

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<PageLayout
  title={title}
  description={description}
  heading="Notes from the"
  headingAccent="work"
  lead="What things actually cost, what breaks in a migration, and what we would do differently. Written for business owners, not for other agencies."
  path={path}
  crumbs={crumbs}
  pageType="CollectionPage"
  extraGraph={extraGraph}
>
  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">New posts are on the way.</p>
    ) : (
      <ul class="grid gap-5 sm:grid-cols-2" data-stagger>
        {posts.map((post) => (
          <li data-stagger-item>
            <a
              href={`/blog/${post.id}/`}
              class="card-panel group flex h-full flex-col p-7 transition-colors hover:border-primary/40"
            >
              <p class="eyebrow">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFmt.format(post.data.pubDate)}
                </time>
              </p>
              <h2 class="mt-3 text-xl font-semibold tracking-tight sm:text-2xl">
                {post.data.title}
              </h2>
              <p class="mt-3 flex-1 text-muted-foreground">{post.data.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary-ink">
                Read
                <span
                  class="transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <CtaBand heading="Got a question we haven't" accent="answered" />
</PageLayout>
