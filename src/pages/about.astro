---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { ID } from '@/lib/schema';

const path = '/about/';
const title = 'About EeroCad | UK Web & Growth Studio';
const description =
  'How EeroCad works: UK-led, remote-first, written scopes before anything is built, and full handover of everything you pay for.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

const extraGraph = [
  {
    '@type': 'AboutPage',
    '@id': `https://eerocad.com${path}#aboutpage`,
    mainEntity: { '@id': ID.org },
  },
];

const howWeWork = [
  {
    n: '01',
    title: 'UK-led, remote-first',
    body: 'Your account lead works UK hours and is the person you actually speak to. You are not handed between account managers, and you are not emailing into a queue.',
  },
  {
    n: '02',
    title: 'A delivery team in New Delhi',
    body: 'Design and build capacity sits with our team in New Delhi, with around four hours of working overlap with the UK each day. We mention it up front because you would find out anyway, and because it is part of why our pricing works.',
  },
  {
    n: '03',
    title: 'Written before built',
    body: 'Scope, price and timeline are agreed in writing before work starts. When something changes we re-quote, rather than absorbing it quietly and resenting it later.',
  },
  {
    n: '04',
    title: 'You own the output',
    body: 'Code, domains, analytics and advertising accounts transfer to you at launch and stay yours regardless of what happens next. It is worth asking every agency you speak to, because the answer is not always this one.',
  },
];

const notUs = [
  'Cheapest-possible websites. There are template services for that, and for some businesses they are genuinely the right answer.',
  'Guaranteed rankings or guaranteed ROAS. Nobody controls the auction or the algorithm, and anyone promising otherwise is selling you something else.',
  'Vanity metrics. Follower counts and impressions are not why you hired an agency.',
];
---

<PageLayout
  title={title}
  description={description}
  heading="A small studio that does the"
  headingAccent="work itself"
  lead="EeroCad is a remote-first web and growth studio working with businesses across the United Kingdom. Websites, search, and the paid campaigns that fill them."
  path={path}
  crumbs={crumbs}
  pageType="AboutPage"
  extraGraph={extraGraph}
>
  {/*
    The founder, in the hero's right-hand half — the same slot the service
    pages use, which exists because that half was empty on every page that
    has one.

    Shown at every size rather than desktop-only. The service pages put a
    navigation card there, which a phone does not need twice; a face is the
    one thing on this site that says a person is behind it, and the page it
    sits on is the one a visitor opens to find that out.

    The first person named anywhere on this site. The blog still has no
    byline, which is the other half of the same problem.
  */}
  <figure
    slot="aside"
    class="card-panel w-full max-w-64 overflow-hidden lg:w-80 lg:max-w-none lg:justify-self-end"
    data-reveal
  >
    <img
      src="/brand/founder.jpg"
      alt="Yatharth, founder of EeroCad"
      width="576"
      height="720"
      class="aspect-[4/5] w-full object-cover"
      decoding="async"
    />
    <figcaption class="border-t border-border px-5 py-4">
      <p class="flex items-center gap-2.5 font-semibold tracking-tight">
        <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        Yatharth
      </p>
      <p class="eyebrow mt-1.5 pl-4">Founder</p>
    </figcaption>
  </figure>

  <section aria-labelledby="how-heading">
    <h2 id="how-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      How we <span class="accent-italic text-primary">work</span>.
    </h2>

    <ul class="stack-divide mt-12 grid gap-0 sm:grid-cols-2 sm:gap-4" data-stagger>
      {
        howWeWork.map((item) => (
          <li data-stagger-item>
            <div class="card-soft h-full">
              <span class="font-mono text-xs text-ink-subtle tabular-nums" aria-hidden="true">
                {item.n}
              </span>
              <h3 class="mt-3 text-xl font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-3 text-muted-foreground">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="not-heading" class="mt-20">
    <h2 id="not-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      What we're <span class="accent-italic text-primary">not</span>.
    </h2>
    <p class="mt-5 max-w-2xl text-lg text-muted-foreground" data-reveal>
      Saying no to the wrong work is how the right work gets done properly.
    </p>

    <ul class="mt-10 max-w-2xl space-y-4" data-stagger>
      {
        notUs.map((item) => (
          <li data-stagger-item class="flex gap-4 border-t border-border pt-4 text-muted-foreground">
            <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand heading="Want to work" accent="with us" />
</PageLayout>
