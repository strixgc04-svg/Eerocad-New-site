---
import PageLayout from '@/layouts/PageLayout.astro';
import Todo from '@/components/Todo.astro';

const path = '/industries/restaurants/';
const title = 'Restaurant Web Design & Marketing Agency | Eerocad';
const description =
  'Websites, local SEO and social for restaurants. Booking integrations, menus that work on mobile, and visibility in local search.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries/' },
  { name: 'Restaurants', path },
];
---

<PageLayout
  title={title}
  description={description}
  heading="Websites and marketing for"
  headingAccent="restaurants"
  lead="Menus that work on a phone, booking that actually converts, and a listing people can find."
  path={path}
  crumbs={crumbs}
>
  <div class="max-w-3xl">
    <Todo
      what="800-1,200 words of restaurant-specific copy"
      blockedOn="The Adachi case study, rewritten with sourced outcomes"
    >
      <p class="mt-3 text-muted-foreground">
        This is the strongest organic opportunity in the plan: roughly 40% of
        results for "web design agency for restaurants" are dedicated restaurant
        agency pages rather than directories, and there is existing restaurant
        work to point at. The competing pages lead with a price band, a delivery
        timeline, and a reservations metric — match that.
      </p>
      <p class="mt-3 text-muted-foreground">
        Resolve the Adachi location question first. The case study says London;
        the testimonial and the restaurant's own site say Birmingham, Michigan.
      </p>
    </Todo>
  </div>
</PageLayout>
