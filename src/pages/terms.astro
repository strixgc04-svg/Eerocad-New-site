---
import PageLayout from '@/layouts/PageLayout.astro';

/*
 * Deliberately short and factual.
 *
 * Binding terms of engagement need a solicitor and need to name the
 * contracting entity — neither of which exists yet. Stating plainly that work
 * is governed by a per-project written agreement is accurate and more use to a
 * buyer than a downloaded template, which is what the old site's empty Terms
 * page was going to become. See docs/content-todo.md.
 */
const path = '/terms/';
const title = 'Terms & Conditions | Eerocad';
const description =
  'The basis on which Eerocad provides website, SEO, paid media and social media services, and how engagements are agreed.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Terms & Conditions', path },
];

const updated = '2 November 2026';
---

<PageLayout
  title={title}
  description={description}
  heading="Terms &"
  headingAccent="Conditions"
  lead={`Last updated ${updated}.`}
  path={path}
  crumbs={crumbs}
>
  <div class="prose-page max-w-2xl">
    <h2>Using this website</h2>
    <p>
      This site is provided for information. We take care to keep it accurate,
      but nothing on it is an offer, a quotation, or advice you should act on
      without speaking to us first. Prices, timelines and service descriptions
      here are indicative and are confirmed in writing for each project.
    </p>
    <p>
      The content, design and code of this site belong to Eerocad unless stated
      otherwise. Client names and logos shown here remain the property of those
      clients.
    </p>

    <h2>How engagements are agreed</h2>
    <p>
      Work is carried out under a written agreement issued for each project or
      retainer. That agreement sets out the scope, the price, the timeline,
      payment terms, ownership of the work, and how either side can bring the
      engagement to an end. Nothing is binding on either of us until it is
      signed.
    </p>
    <p>
      We will send you that agreement before any work begins. If you would like
      to see our standard terms before a quote, email
      <a href="mailto:info@eerocad.com">info@eerocad.com</a> and we will send
      them over.
    </p>

    <h2>What we do and do not promise</h2>
    <p>
      We commit to the work described in your agreement, and to reporting
      honestly on what it produced. We do not guarantee specific search
      positions, advertising returns, or follower growth, because no agency
      controls the auctions and algorithms those depend on.
    </p>

    <h2>Third-party services</h2>
    <p>
      Projects commonly involve services we do not control — hosting providers,
      Shopify, WordPress, Meta, Google, booking platforms. We are not
      responsible for their availability, their pricing changes, or their own
      terms, and we will tell you which ones a project depends on before you
      commit.
    </p>

    <h2>Links from this site</h2>
    <p>
      Where we link to other websites, we are not responsible for their content
      or their privacy practices.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about these terms: <a href="mailto:info@eerocad.com"
        >info@eerocad.com</a
      >.
    </p>
  </div>
</PageLayout>
