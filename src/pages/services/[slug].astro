---
import type { GetStaticPaths } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES, breadcrumb, webPage, ID, abs } from '@/lib/schema';
import { SERVICE_CONTENT } from '@/data/services';

export const getStaticPaths = (() =>
  SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;
const content = SERVICE_CONTENT[service.slug];
const path = `/services/${service.slug}/`;

const titles: Record<string, string> = {
  'web-design-development': 'Web Design & Development Agency UK | EeroCad',
  seo: 'SEO Agency UK | Technical, On-Page & Local SEO | EeroCad',
  'performance-marketing': 'Meta & Google Ads Agency UK | EeroCad',
  'social-media-management': 'Social Media Management Agency UK | EeroCad',
};

const descriptions: Record<string, string> = {
  'web-design-development':
    'Websites built to convert for UK businesses. Shopify, WordPress and custom builds with Core Web Vitals and SEO foundations wired in from the start.',
  seo: 'SEO for UK businesses: technical fixes, intent-matched content and local search. Reported in enquiries, not vanity rankings.',
  'performance-marketing':
    'Meta and Google Ads managed against a number you agree up front, with tracking and landing pages built as one thing.',
  'social-media-management':
    'Social media management for UK businesses: strategy, content production and community management on a consistent cadence.',
};

const title = titles[service.slug] ?? `${service.name} | EeroCad`;
const description = descriptions[service.slug] ?? service.description;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.name, path },
];

const extraGraph = [
  {
    '@type': 'Service',
    '@id': `${abs(path)}#service`,
    name: service.name,
    serviceType: service.serviceType,
    description,
    url: abs(path),
    provider: { '@id': ID.org },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
  },
];
---

<PageLayout
  title={title}
  description={description}
  heading={service.name}
  eyebrow={service.serviceType}
  path={path}
  crumbs={crumbs}
  lead={content.intro}
  extraGraph={extraGraph}
>
  {/*
    The hero's right half used to be empty on every one of these pages. It
    now carries the other three services, which is both the thing a visitor
    on the wrong page needs and a set of internal links between four pages
    that previously only met in the footer.

    Desktop only. There is no right-hand half on a phone, so it would land
    between the lead and the first real section and cost a full screen
    before the page said anything. The footer carries the same four links on
    every page, so nothing is lost there.
  */}
  <nav
    slot="aside"
    aria-label="All services"
    class="card-panel hidden overflow-hidden lg:block lg:w-80 lg:justify-self-end"
    data-reveal
  >
    <p class="eyebrow border-b border-border px-5 py-4">All services</p>
    <ul>
      {
        SERVICES.map((s) =>
          s.slug === service.slug ? (
            <li class="border-b border-border last:border-b-0">
              <span
                class="flex min-h-12 items-center gap-3 bg-paper-warm px-5 text-sm font-medium"
                aria-current="page"
              >
                <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                {s.name}
              </span>
            </li>
          ) : (
            <li class="border-b border-border last:border-b-0">
              <a
                href={`/services/${s.slug}/`}
                class="group flex min-h-12 items-center justify-between gap-3 px-5 text-sm text-muted-foreground transition-colors hover:bg-paper-warm hover:text-ink"
              >
                <span>{s.name}</span>
                <span
                  class="translate-x-0 opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
  {/* Who it is for / not for. The old site never said no to anyone, which
      reads as desperate and wastes everyone's time on bad-fit calls. */}
  <section aria-labelledby="fit-heading" class="stack-divide grid gap-0 sm:gap-4 lg:grid-cols-2 lg:gap-5">
    <h2 id="fit-heading" class="sr-only">Who this is for</h2>

    <div class="card-soft" data-reveal>
      <p class="eyebrow flex items-center gap-2.5">
        <span
          class="inline-flex size-6 items-center justify-center rounded-full bg-primary text-white"
          aria-hidden="true"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </span>
        A good fit if
      </p>
      <ul class="mt-5 space-y-3.5">
        {
          content.forWho.map((item) => (
            <li class="flex gap-3 text-muted-foreground">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card-soft-warm" data-reveal>
      <p class="eyebrow flex items-center gap-2.5">
        <span
          class="inline-flex size-6 items-center justify-center rounded-full border border-input text-ink-subtle"
          aria-hidden="true"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </span>
        Probably not if
      </p>
      <ul class="mt-5 space-y-3.5">
        {
          content.notForWho.map((item) => (
            <li class="flex gap-3 text-muted-foreground">
              <span
                class="mt-2 size-1.5 shrink-0 rounded-full bg-ink-subtle"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* What's included */}
  <section aria-labelledby="included-heading" class="mt-20">
    <h2 id="included-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      What's <span class="accent-italic text-primary">included</span>.
    </h2>

    <ul class="stack-divide mt-12 grid gap-0 sm:grid-cols-2 sm:gap-4" data-stagger>
      {
        content.included.map((item, i) => (
          <li data-stagger-item>
            <div
              data-spotlight
              class="spotlight card-soft relative isolate flex h-full flex-col overflow-hidden"
            >
              {/*
                Two numbers, one at a time. Below sm a card has no border or
                background to sit the big figure against, so the small mono
                one carries the count; from sm up the figure becomes part of
                the card and the mono one would just repeat it.
              */}
              <span class="font-mono text-xs text-ink-subtle tabular-nums sm:hidden" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span
                class="pointer-events-none absolute -top-5 right-1 hidden text-[5.5rem] leading-none font-semibold tabular-nums text-ink/[0.05] select-none sm:block"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-xl font-semibold tracking-tight sm:mt-0">{item.title}</h3>
              <p class="mt-3 text-muted-foreground">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    How we quote — real, and it links to the page that explains it.

    On a dark panel, and sitting here rather than after the process, for two
    reasons. The page ran white from the breadcrumb to the CTA band, and this
    is its midpoint; and left where it was, its panel landed a screen above
    the CTA band's, stacking three dark blocks into the last third of the
    page. Price after what you get, before how it runs.
  */}
  <section aria-labelledby="price-heading" class="mt-20">
    <div
      class="panel-dark dotgrid relative isolate overflow-hidden rounded-[2.5rem] px-6 py-12 sm:px-12 sm:py-16"
      data-reveal
    >
      <div class="wash opacity-50" aria-hidden="true">
        <div class="wash__blob wash__blob--2"></div>
      </div>

      <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
        <div class="max-w-2xl">
          <p class="eyebrow">What it costs</p>
          <h2 id="price-heading" class="display-lg mt-5 text-balance">
            Quoted against a written <span class="accent-italic text-primary">scope</span>.
          </h2>
          <p class="mt-5 text-muted-foreground">
            The quote is in your hands within 48 hours of a scoping call. No
            open-ended day rates, and no number that moves after you have
            signed.
          </p>
        </div>

        <a
          href="/pricing/"
          class="group inline-flex min-h-13 shrink-0 items-center gap-2 rounded-full bg-white px-7 font-medium text-ink transition-colors hover:bg-primary hover:text-white"
        >
          How we price
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true">&rarr;</span
          >
        </a>
      </div>
    </div>
  </section>

  {/* Process */}
  <section aria-labelledby="process-heading" class="mt-20">
    <h2 id="process-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      How it <span class="accent-italic text-primary">runs</span>.
    </h2>

    {/*
      The same scroll-drawn rail the home page uses for its process, so the
      two read as one device. Bare on the rail rather than in cards: the
      deliverables above are already a grid of boxes, and a second one
      directly beneath it was most of why this page read as flat.
    */}
    <div class="rail mt-12 pl-10 sm:pl-16" data-rail>
      <div class="rail__line left-0" aria-hidden="true"></div>
      <div class="rail__progress left-0" data-rail-progress aria-hidden="true"></div>

      <ol class="space-y-8 sm:space-y-12">
        {
          content.process.map((step, i) => (
            <li class="relative" data-reveal>
              <span
                class="absolute top-1.5 -left-10 flex size-5 items-center justify-center sm:-left-16"
                aria-hidden="true"
              >
                <span class="size-2.5 rounded-full bg-primary ring-4 ring-paper" />
              </span>

              <p class="font-mono text-xs text-primary-ink tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">{step.title}</h3>
              <p class="mt-3 max-w-xl text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mt-10 max-w-2xl text-muted-foreground" data-reveal>{content.timelineNote}</p>
  </section>

  {/* FAQ — native details, answers in the HTML */}
  <section aria-labelledby="faq-heading" class="mt-20">
    <h2 id="faq-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      Questions.
    </h2>

    <div class="mt-10 max-w-3xl divide-y divide-border border-y border-border">
      {
        content.faqs.map((item) => (
          <details class="faq-item group">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-medium transition-colors hover:text-primary">
              <span>{item.q}</span>
              <span
                class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-border text-xl leading-none transition-all duration-300 group-open:rotate-45 group-open:border-primary group-open:bg-primary group-open:text-white"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaBand heading="Want to talk about" accent="your project" />
</PageLayout>
