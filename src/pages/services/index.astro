---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SERVICES, breadcrumb, webPage, serviceNodes } from '@/lib/schema';
import { SERVICE_CONTENT } from '@/data/services';

const path = '/services/';
const title = 'Services | Web Design, SEO & Paid Ads | EeroCad';
const description =
  'Website development, SEO, performance marketing and social media management for UK businesses. Scope, process and honest timelines for each.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path },
];
---

<PageLayout
  title={title}
  description={description}
  heading="Four things, done"
  headingAccent="properly"
  lead="Each has its own page, because each is a different decision with a different budget. Pick the one you actually need."
  path={path}
  crumbs={crumbs}
  pageType="CollectionPage"
  extraGraph={serviceNodes()}
>
  <ul class="border-t border-border" data-stagger>
    {
      SERVICES.map((s, i) => (
        <li data-stagger-item class="border-b border-border">
          <a
            href={`/services/${s.slug}/`}
            data-spotlight
            class="spotlight group grid gap-3 py-5 sm:grid-cols-[4rem_1fr_auto] sm:items-baseline sm:gap-8 sm:py-10"
          >
            <span class="font-mono text-sm text-ink-subtle tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="max-w-2xl">
              <h2 class="text-2xl font-semibold tracking-tight transition-transform duration-500 group-hover:translate-x-1 sm:text-4xl">
                {s.name}
              </h2>
              <p class="mt-3 text-muted-foreground">{SERVICE_CONTENT[s.slug]?.intro}</p>

              {/*
                The first three deliverables, read off the same content the
                service page renders in full. A row of four names and four
                paragraphs told a visitor nothing about what separates them;
                this does, and it cannot drift from the page it summarises.
              */}
              <ul class="mt-5 flex flex-wrap gap-2">
                {SERVICE_CONTENT[s.slug]?.included.slice(0, 3).map((item) => (
                  <li class="rounded-full border border-border bg-paper-warm px-3.5 py-1.5 text-xs text-muted-foreground">
                    {item.title}
                  </li>
                ))}
              </ul>
            </div>

            <span
              class="inline-flex size-11 items-center justify-center rounded-full border border-border transition-colors group-hover:border-primary group-hover:bg-primary group-hover:text-white"
              aria-hidden="true"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <CtaBand heading="Not sure which you" accent="actually need" />
</PageLayout>
