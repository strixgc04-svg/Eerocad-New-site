---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Todo from '@/components/Todo.astro';
import { SERVICES } from '@/lib/schema';

const path = '/pricing/';
const title = 'Pricing | What a Website or Campaign Costs | Eerocad';
const description =
  'Published price bands for websites, SEO, paid media and social media management, so you know roughly what it costs before booking a call.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path },
];

const principles = [
  {
    title: 'Fixed scope, fixed price',
    body: 'Project work is quoted against a written scope. If the scope changes, we re-quote before doing the work rather than after.',
  },
  {
    title: 'You own what you pay for',
    body: 'Code, domains, analytics and advertising accounts are yours. They transfer at launch and stay yours if we stop working together.',
  },
  {
    title: 'Ad spend is separate',
    body: 'Media spend goes directly to Meta or Google from your own account. Our fee covers the management and is invoiced separately.',
  },
  {
    title: 'No lock-in on retainers',
    body: 'TODO: state the actual notice period. UK buyers ask this early, and a vague answer costs you the deal.',
  },
];
---

<PageLayout
  title={title}
  description={description}
  heading="You should know roughly what this"
  headingAccent="costs"
  lead="Before you give anyone half an hour of your time. These are the bands we work in, and how we charge."
  path={path}
  crumbs={crumbs}
>
  <section aria-labelledby="bands-heading">
    <h2 id="bands-heading" class="sr-only">Price bands</h2>

    <ul class="stack-divide grid gap-0 sm:grid-cols-2 sm:gap-4" data-stagger>
      {
        SERVICES.map((s) => (
          <li data-stagger-item>
            <div
              data-spotlight
              class="spotlight card-soft flex h-full flex-col"
            >
              <h3 class="text-lg font-semibold tracking-tight">{s.name}</h3>
              <p class="mt-5 text-4xl font-semibold tracking-tight text-ink-subtle">£TODO</p>
              <p class="mt-2 text-sm text-muted-foreground">Typical engagement: TODO</p>
              <a
                href={`/services/${s.slug}/`}
                class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-primary-ink"
              >
                What's included <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 max-w-2xl" data-reveal>
      <Todo
        what="A real band per service, and whether figures exclude VAT"
        blockedOn="A business decision. This page is also the route to the 'how much does a website cost uk' query cluster."
      />
    </div>
  </section>

  <section aria-labelledby="how-heading" class="mt-20">
    <h2 id="how-heading" class="display-lg max-w-2xl text-balance" data-reveal>
      How we <span class="accent-italic text-primary">charge</span>.
    </h2>

    <ul class="stack-divide mt-12 grid gap-0 sm:grid-cols-2 sm:gap-4" data-stagger>
      {
        principles.map((p) => (
          <li data-stagger-item>
            <div class="card-soft-warm h-full">
              <h3 class="text-lg font-semibold tracking-tight">{p.title}</h3>
              <p class="mt-3 text-muted-foreground">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand heading="Want a number for" accent="your project" />
</PageLayout>
