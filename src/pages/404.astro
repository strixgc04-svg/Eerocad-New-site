---
import BaseLayout from '@/layouts/BaseLayout.astro';

// A real 404 page. The current deployment returns an 80-byte plain-text
// Vercel error with no navigation and no branding - and returns it for ten
// of the site's eleven URLs.
---

<BaseLayout
  title="Page not found | EeroCad"
  description="That page does not exist. Browse our services, work or get in touch."
  noindex
>
  <div class="container-page flex min-h-[60vh] flex-col justify-center py-20">
    <p class="text-sm font-medium text-primary-ink">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mt-6 max-w-lg text-lg text-muted-foreground">
      That page doesn't exist, or it has moved. Here's where to go instead.
    </p>

    <ul class="mt-8 flex flex-wrap gap-3">
      {
        [
          { href: '/services/', label: 'Services' },
          { href: '/work/', label: 'Work' },
          { href: '/pricing/', label: 'Pricing' },
          { href: '/contact/', label: 'Contact' },
        ].map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-11 items-center rounded-lg border border-border px-5 transition-colors hover:bg-secondary"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
