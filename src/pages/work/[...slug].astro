---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { orgRef, abs } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const path = `/work/${entry.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work/' },
  { name: entry.data.client, path },
];

const extraGraph = [
  {
    '@type': 'Organization',
    '@id': `${abs(path)}#client`,
    name: entry.data.client,
  },
];
// No Review or AggregateRating: self-published reviews of your own
// organisation are not eligible for rich results, and the outcome figures
// are marketing claims, not ratings.
---

<PageLayout
  title={`${entry.data.title} | Eerocad`}
  description={entry.data.description}
  heading={entry.data.client}
  lead={entry.data.description}
  path={path}
  crumbs={crumbs}
  extraGraph={extraGraph}
>
  <dl
    class="flex flex-wrap gap-x-12 gap-y-5 rounded-[var(--radius-xl)] border border-border bg-paper-warm p-7 text-sm"
    data-reveal
  >
    <div>
      <dt class="eyebrow">Sector</dt>
      <dd class="mt-1.5 font-medium">{entry.data.sector}</dd>
    </div>
    <div>
      <dt class="eyebrow">Services</dt>
      <dd class="mt-1.5 font-medium">{entry.data.services.join(' · ')}</dd>
    </div>
    {
      entry.data.liveUrl && (
        <div>
          <dt class="eyebrow">Live site</dt>
          <dd class="mt-1.5">
            <a href={entry.data.liveUrl} rel="noopener" class="font-medium text-primary-ink">
              Visit site
            </a>
          </dd>
        </div>
      )
    }
  </dl>

  {
    entry.data.outcomes.length > 0 && (
      <ul class="stack-divide mt-6 grid gap-0 sm:grid-cols-3 sm:gap-4" data-stagger>
        {entry.data.outcomes.map((o) => (
          <li data-stagger-item>
            <div
              class="card-soft h-full"
            >
              <p class="text-4xl font-semibold tracking-tight text-primary">{o.value}</p>
              <p class="mt-2 font-medium">{o.metric}</p>
              {/* Period and source are required by the content schema.
                  No unsourced numbers. */}
              <p class="mt-3 text-xs text-muted-foreground">
                {o.period} · Source: {o.source}
              </p>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <div class="prose-page mt-14 max-w-2xl" data-reveal>
    <Content />
  </div>

  <CtaBand heading="Want something like" accent="this" />
</PageLayout>
